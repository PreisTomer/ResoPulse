{
  "name": "resopulse-backend",
  "version": "0.1.0",
  "description": "ResoPulse API server — biophysical field modelling backend",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "prisma generate && tsc",
    "start": "npx prisma migrate deploy && node dist/index.js",
    "demo": "node scripts/demo.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@clerk/express": "^2.1.0",
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "@types/pg": "^8.20.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.1",
    "express": "^4.18.2",
    "pg": "^8.20.0",
    "socket.io": "^4.8.3",
    "svix": "^1.90.0"
  },
  "devDependencies": {
    "@ngrok/ngrok": "^1.4.0",
    "@vitest/coverage-v8": "^4.1.4",
    "prisma": "^7.7.0",
    "socket.io-client": "^4.8.3",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3",
    "vitest": "^4.1.4"
  }
}
