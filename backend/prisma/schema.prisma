generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ── User ─────────────────────────────────────────────────────────────────────
// Synced from Clerk via webhook (user.created / user.updated / user.deleted).
// id is the Clerk userId (string, e.g. "user_2abc...").

model User {
  id          String       @id
  email       String       @unique
  name        String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  memberships Membership[]

  @@map("users")
}

// ── Organization ─────────────────────────────────────────────────────────────
// Synced from Clerk Organizations. Represents a "lab workspace".
// id is the Clerk orgId (string, e.g. "org_2abc...").

model Organization {
  id          String       @id
  name        String
  slug        String?      @unique
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  memberships Membership[]

  @@map("organizations")
}

// ── Membership ────────────────────────────────────────────────────────────────
// Junction between User and Organization.
// role mirrors Clerk's org role string: "org:owner" | "org:admin" | "org:member" | "org:viewer"
// Custom roles can be defined in the Clerk dashboard and added here.

model Membership {
  id        String   @id @default(cuid())
  userId    String
  orgId     String
  role      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
  @@map("memberships")
}

// ── Outcome ───────────────────────────────────────────────────────────────────
// AI training data: one row per user-rated experiment outcome.
// Migrated from SQLite (better-sqlite3) to Postgres for persistent storage.

model Outcome {
  id             Int      @id @default(autoincrement())
  createdAt      DateTime @default(now())
  sessionName    String?
  timestamp      String?
  freqKhz        Int
  fieldVcm       Int
  medium         String
  targetPreset   String
  waveform       String
  dutyCycle      Float
  pulseWidthNs   Int
  orientationDeg Int
  lysisNPulses   Int
  targetRatio    Float
  healthyRatio   Float
  selectivity    Float
  targetTemp     Float
  healthyTemp    Float
  rating         Int
  aiSuggested    Boolean  @default(false)
  targetTauNs    Float    @default(0)
  healthyTauNs   Float    @default(0)
  targetFcKhz    Float    @default(0)
  healthyFcKhz   Float    @default(0)
  targetRadiusUm Float    @default(0)
  sigmaE         Float    @default(0)

  @@index([targetPreset])
  @@index([rating])
  @@index([targetTauNs])
  @@map("outcomes")
}
