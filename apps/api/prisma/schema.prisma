generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ── User ─────────────────────────────────────────────────────────────────────
// Synced from Clerk via webhook (user.created / user.updated / user.deleted).
// id is the Clerk userId (string, e.g. "user_2abc...").

model User {
  id          String       @id
  email       String       @unique
  name        String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  memberships Membership[]

  @@map("users")
}

// ── Organization ─────────────────────────────────────────────────────────────
// Synced from Clerk Organizations. Represents a "lab workspace".
// id is the Clerk orgId (string, e.g. "org_2abc...").

model Organization {
  id           String              @id
  name         String
  slug         String?             @unique
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  memberships  Membership[]
  tokenAccount TokenAccount?
  experiments  ExperimentSession[]
  cellPresets  UserCellPreset[]
  calibrations CellCalibration[]

  @@map("organizations")
}

// ── Membership ────────────────────────────────────────────────────────────────
// Junction between User and Organization.
// role mirrors Clerk's org role string: "org:owner" | "org:admin" | "org:member" | "org:viewer"

model Membership {
  id        String   @id @default(cuid())
  userId    String
  orgId     String
  role      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
  @@map("memberships")
}

// ── ExperimentSession ─────────────────────────────────────────────────────────
// One saved experiment per row. snapshot is a JSONB blob holding the full
// serialisable state: cell parameters, field settings, log entries, notes.
// Soft-deleted via deletedAt. parentId chains version history and forks.

model ExperimentSession {
  id          String    @id @default(cuid())
  orgId       String
  createdBy   String    // Clerk userId of the creator
  title       String    @db.VarChar(120)
  description String?   @db.VarChar(500)
  snapshot    Json      // JSONB: ExperimentSnapshot (frontend-defined shape)
  version     Int       @default(1)
  parentId    String?   // non-null for versions and forks; null for root experiments
  shareToken  String?   @unique @db.VarChar(64)
  shareMode   String?   @db.VarChar(8)  // "view" | "edit" | null (private)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  org    Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  parent ExperimentSession?  @relation("ExperimentVersions", fields: [parentId], references: [id])
  forks  ExperimentSession[] @relation("ExperimentVersions")

  @@index([orgId, deletedAt])
  @@index([shareToken])
  @@index([orgId, updatedAt])
  @@map("experiment_sessions")
}

// ── TokenAccount ─────────────────────────────────────────────────────────────
// One row per Organisation. Holds the current balance and plan metadata.
// Monthly quota resets are handled at debit time (resetAt checked in $transaction).
// plan values: "free" | "pro" | "team" | "enterprise"

model TokenAccount {
  id                   String   @id @default(cuid())
  orgId                String   @unique
  plan                 String   @default("free")
  monthlyQuota         Int      @default(200)
  balance              Int      @default(200)
  resetAt              DateTime // next reset timestamp; checked at every debit
  stripeCustomerId     String?
  stripeSubscriptionId String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  org          Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  transactions TokenTransaction[]

  @@map("token_accounts")
}

// ── TokenTransaction ──────────────────────────────────────────────────────────
// Immutable audit log of every debit/credit. delta < 0 = debit, delta > 0 = credit.
// reason references a COST_MAP key or special values: "monthly_reset", "plan_upgrade",
// "stripe_topup", "admin_grant".

model TokenTransaction {
  id        String   @id @default(cuid())
  accountId String
  userId    String   // Clerk userId who triggered the action
  delta     Int      // negative = debit; positive = credit/refill
  reason    String   @db.VarChar(80)
  meta      Json?    // optional context: { experimentId, requestId, … }
  createdAt DateTime @default(now())

  account TokenAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, createdAt])
  @@map("token_transactions")
}

// ── UserCellPreset ────────────────────────────────────────────────────────────
// Lab-level custom cell definitions. One row per cell profile created by a lab.
// role: "target" | "healthy" — determines which picker the cell appears in.
// cellType: "mammalian" | "bacteria" | "virus" — governs which physics path runs.

model UserCellPreset {
  id                   String   @id @default(cuid())
  orgId                String
  createdBy            String
  role                 String   @db.VarChar(8)    // "target" | "healthy"
  cellType             String   @db.VarChar(12)   // "mammalian" | "bacteria" | "virus"
  label                String   @db.VarChar(120)
  shortLabel           String   @db.VarChar(40)
  notes                String?  @db.VarChar(500)
  // "literature" | "measured" | "estimated" — how the parameters were obtained
  parameterConfidence  String   @default("literature") @db.VarChar(16)
  // ── Required Schwan / thermal parameters ──────────────────────────────────
  radius               Float
  membraneThickness    Float
  dielectricConstant   Float
  conductivity         Float
  thresholdVoltage     Float
  density              Float
  specificHeatCapacity Float
  // ── σ_i provenance (optional — most uncertain Schwan parameter) ───────────
  // sigmaSource: "literature" | "measured" | "electrorotation" | "impedance" | "estimated"
  sigmaUncertaintyPct  Float?
  sigmaSource          String?  @db.VarChar(16)
  sigmaCitation        String?  @db.VarChar(500)
  // ── Acoustic / mechanical resonance (bacteria / virus only) ───────────────
  resonantFreqGHz      Float?
  capsidQ              Float?
  resonantThresholdVcm Float?
  // ── Timestamps ────────────────────────────────────────────────────────────
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("user_cell_presets")
}

// ── CellCalibration ──────────────────────────────────────────────────────────
// Per-lab (org) two-parameter physics-inversion fit per cell preset and physics
// mode. Fitted server-side via scipy LM against bench-measured outcome rows;
// the AI service inverts the actual forward physics.
//
// Schwan path:    param1Mult → σ_i multiplier
//                 param2Mult → V_th multiplier
// Resonance path: param1Mult → Q (capsid quality factor) multiplier
//                 param2Mult → V_thr (acoustic threshold) multiplier
//
// cov11 / cov12 / cov22 are the post-fit 2x2 parameter covariance on the
// multiplier scale — used by the frontend Jacobian propagation to render
// honest TI / Vm / population uncertainty bands.
//
// param1Unident / param2Unident flag the case where (JᵀJ) was ill-conditioned
// (e.g. all measurements at low frequency leave σ_i unidentifiable); the
// pinned multiplier is 1.0 and that direction's covariance is zeroed.
//
// One active row per (orgId, cellPresetId, mode). Legacy fields sigmaMultiplier
// / uncertaintyStd are kept for one release of read-side compatibility.

model CellCalibration {
  id              String   @id @default(cuid())
  orgId           String
  cellPresetId    String   // built-in cellLibrary id or UserCellPreset.id
  mode            String   @default("schwan")    @db.VarChar(12)   // "schwan" | "resonance"
  category        String   @default("mammalian") @db.VarChar(12)   // "mammalian" | "bacteria" | "virus"
  // Two-parameter physics-inversion fit
  param1Mult      Float    @default(1.0)
  param2Mult      Float    @default(1.0)
  cov11           Float    @default(0.0)
  cov12           Float    @default(0.0)
  cov22           Float    @default(0.0)
  residualStd     Float    @default(0.0)
  param1Clamped   Boolean  @default(false)
  param2Clamped   Boolean  @default(false)
  param1Unident   Boolean  @default(false)
  param2Unident   Boolean  @default(false)
  // Legacy scalar fit (read-side compat)
  sigmaMultiplier Float    @default(1.0)
  uncertaintyStd  Float    @default(0.0)
  nSamples        Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, cellPresetId, mode])
  @@index([orgId])
  @@map("cell_calibrations")
}

// ── TrainerMetrics ──────────────────────────────────────────────────────────
// One row per retrain attempt. Persists the holdout RMSE/MAE per outcome so
// the ReportsView can trend "model error over time" and the server can
// promotion-gate new bundles against the previous best MAE. `promoted=true`
// means the new bundle replaced the active model; `promoted=false` means the
// fit ran but the in-memory bundle was retained because the holdout was worse.

model TrainerMetrics {
  id                String   @id @default(cuid())
  modelVersion      String   @unique @db.VarChar(40)
  trainedAt         DateTime @default(now())
  nSamples          Int
  holdoutSamples    Int
  rmseTargetDr      Float
  maeTargetDr       Float
  rmseHealthyDr     Float
  maeHealthyDr      Float
  rmseRating        Float
  maeRating         Float
  holdoutMaeOverall Float
  previousBestMae   Float?
  promoted          Boolean  @default(false)

  @@index([trainedAt])
  @@index([promoted, trainedAt])
  @@map("trainer_metrics")
}

// ── Outcome ───────────────────────────────────────────────────────────────────
// AI training data: one row per user-rated experiment outcome.

model Outcome {
  id             Int      @id @default(autoincrement())
  createdAt      DateTime @default(now())
  // Clerk orgId (nullable: historical rows predate org-scoped logging).
  // Calibration fits only use rows where orgId matches the caller's org so
  // each lab's corrections stay isolated.
  orgId          String?
  sessionName    String?
  timestamp      String?
  freqKhz        Int
  fieldVcm       Int
  medium         String
  targetPreset   String
  waveform       String
  dutyCycle      Float
  pulseWidthNs   Int
  orientationDeg Int
  lysisNPulses   Int
  targetRatio    Float
  healthyRatio   Float
  selectivity    Float
  targetTemp     Float
  healthyTemp    Float
  rating         Int
  aiSuggested    Boolean  @default(false)
  targetTauNs    Float    @default(0)
  healthyTauNs   Float    @default(0)
  targetFcKhz    Float    @default(0)
  healthyFcKhz   Float    @default(0)
  targetRadiusUm Float    @default(0)
  sigmaE         Float    @default(0)

  // ── Measured outcomes (Stage C.2) ─────────────────────────────────────────
  // Populated via logMeasuredOutcome socket event after the scientist records
  // bench measurements. All nullable: a row starts as pure prediction and
  // gains measured columns once the assay is read.
  measuredAt               String?
  measuredTargetLysisPct   Float?
  measuredHealthyLysisPct  Float?
  measuredViabilityPct     Float?
  measuredPermeabilizedPct Float?
  measuredTransfectionPct  Float?
  measuredViabilityAssay   String? @db.VarChar(20)
  measuredAssayTimepointH  Float?
  measuredTempC            Float?
  measuredFieldVcm         Float?
  measuredLysisDelayMs     Int?
  // qPCR fold-change: 2^(-ΔΔCt) for a named transcript; values <1 indicate
  // knockdown, >1 upregulation. Primary gene label travels alongside.
  measuredQpcrFoldChange   Float?
  measuredQpcrTarget       String? @db.VarChar(60)
  measuredNotes            String? @db.VarChar(500)

  @@index([targetPreset])
  @@index([rating])
  @@index([targetTauNs])
  @@index([sessionName, timestamp])
  @@index([orgId, targetPreset])
  @@index([orgId, sessionName, timestamp])
  @@map("outcomes")
}
