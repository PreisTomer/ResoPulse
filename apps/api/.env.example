# Copy this file to .env and fill in your values.
# .env is gitignored and never committed.

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── CORS ─────────────────────────────────────────────────────────────────────
# Production: set to your Vercel / Netlify frontend domain.
FRONTEND_URL=https://your-frontend.vercel.app

# ── Clerk (required) ─────────────────────────────────────────────────────────
# Get from: https://dashboard.clerk.com → Your app → API Keys
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Clerk Webhook ─────────────────────────────────────────────────────────────
# Get from: https://dashboard.clerk.com → Your app → Webhooks → Signing secret
CLERK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Database (PostgreSQL via Prisma) ─────────────────────────────────────────
# Supabase, Railway, Neon, or any Postgres connection string.
DATABASE_URL=postgresql://user:password@host:5432/simbiotix?schema=public

# ── SQLite (existing outcomes DB) ────────────────────────────────────────────
DATA_DIR=./data

# ── AI microservice ───────────────────────────────────────────────────────────
AI_SERVICE_URL=http://localhost:8000
AI_PROXY_TIMEOUT_MS=10000

# ── AI training data access ───────────────────────────────────────────────────
# Optional shared secret to restrict the /ai/training-data endpoint.
TRAINING_DATA_SECRET=
