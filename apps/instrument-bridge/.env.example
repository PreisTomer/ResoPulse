# ResoPulse Instrument Bridge — Environment Configuration
# Copy this file to .env and fill in the values for your setup.
# CLI flags override these values when provided.

# ── Connection ────────────────────────────────────────────────────────────────

# Socket.IO backend URL. Must include the scheme (http:// or https://).
# For a remote ngrok session use the full ngrok URL e.g. https://abc123.ngrok.io
BRIDGE_BACKEND_URL=http://localhost:3001

# ── Driver selection ──────────────────────────────────────────────────────────

# Which instrument driver to use.
# Options: demo | btx | visa_lcr | ascii_serial
#
#   demo         Synthetic cuvette data. No hardware needed. Use this first
#                to verify the bridge reaches the backend and the UI shows live
#                impedance readings before connecting real equipment.
#
#   btx          BTX ECM 830 / ECM 2001 electroporator via RS-232 serial.
#                Reads post-pulse cuvette resistance. Requires pyserial:
#                  uv sync --extra serial
#
#   visa_lcr     VISA-compatible LCR meter (Keysight E4980A, Hioki IM3533,
#                Agilent 4284A, or any SCPI-compliant impedance analyser).
#                Requires pyvisa + pyvisa-py (or a NI-VISA / Keysight IO
#                backend installation):
#                  uv sync --extra visa
#
#   ascii_serial Generic ASCII serial LCR meter (e.g. DER EE DE-5000, Peak
#                LCR45). Reads one line per poll and parses the first numeric
#                tokens as Z_real [, Z_imag]. Requires pyserial:
#                  uv sync --extra serial
BRIDGE_DRIVER=demo

# ── Serial port (btx and ascii_serial drivers) ────────────────────────────────

# Windows: COM1, COM2, COM3, ...
# macOS:   /dev/tty.usbserial-XXXX or /dev/cu.usbserial-XXXX
# Linux:   /dev/ttyUSB0 or /dev/ttyS0
#
# Run  instrument-bridge probe  to list ports detected on this machine.
BRIDGE_SERIAL_PORT=COM3

# Baud rate. BTX ECM 830: 9600. DE-5000: 2400. Most others: 9600.
BRIDGE_BAUD_RATE=9600

# ── VISA resource string (visa_lcr driver) ────────────────────────────────────

# GPIB example:       GPIB0::17::INSTR
# USB example:        USB0::0x0957::0x0909::MY12345678::INSTR
# LAN/VXI-11 example: TCPIP0::192.168.1.100::inst0::INSTR
# LAN/HiSLIP example: TCPIP0::192.168.1.100::hislip0::INSTR
#
# Run  instrument-bridge probe  to list VISA resources detected on this machine.
BRIDGE_VISA_RESOURCE=GPIB0::17::INSTR

# ── Measurement parameters ────────────────────────────────────────────────────

# Frequency [Hz] commanded to the instrument for each reading.
# For LCR meters: sets the AC test frequency.
# For ascii_serial: declared only (instrument is not commanded — set it on the
#   front panel and enter the same value here so the bridge reports it correctly).
# For btx: ignored (BTX measures at quasi-DC after each pulse).
BRIDGE_MEAS_FREQ_HZ=1000.0

# Time between readings [seconds]. Float allowed (e.g. 0.5 for 2 Hz).
# Minimum: 0.05 s. Maximum: 60 s.
# Note: for instruments with slow settling times (LCR aperture LONG) set this
# at least 0.5 s above the instrument's integration time.
BRIDGE_POLL_INTERVAL_S=1.0

# ── Demo driver settings ──────────────────────────────────────────────────────

# Frequency sweep range for the demo driver [Hz].
# The demo steps logarithmically through this range across consecutive polls.
BRIDGE_DEMO_FREQ_MIN_HZ=100.0
BRIDGE_DEMO_FREQ_MAX_HZ=10000000.0

# Demo cuvette geometry for synthetic Z calculation.
# Default: BTX 4 mm gap cuvette (standard 0.4 cm gap, ~0.5 cm² electrode area).
BRIDGE_DEMO_CUVETTE_GAP_MM=4.0
BRIDGE_DEMO_CUVETTE_AREA_CM2=0.5

# ── Logging ───────────────────────────────────────────────────────────────────

# Loguru log level: TRACE | DEBUG | INFO | WARNING | ERROR
BRIDGE_LOG_LEVEL=INFO
